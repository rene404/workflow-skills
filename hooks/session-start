#!/usr/bin/env bash
# SessionStart hook for the workflow-skills plugin.
#
# Injects routing guidance into the agent's context at the start of every
# session, so it picks the smallest combination of skill/agent/prompt/
# instruction for the user's request before doing work.
#
# What gets injected depends on the project:
#   - Project has its own router (skills/using-<project>/SKILL.md or
#     .claude/skills/using-<project>/SKILL.md) -> inject that router in full.
#     It has concrete routes for this codebase; that is the useful one.
#   - No project router -> inject a slim fallback naming the available skills
#     and the standard chain. The plugin's own using-template is never
#     injected: its routing table is an empty placeholder, so shipping it into
#     every session costs context and routes nothing.
#
# Detects the harness via env vars and emits the right JSON dialect:
#   - Cursor:      additional_context (snake_case, top-level)
#   - Claude Code: hookSpecificOutput.additionalContext (nested)
#   - Codex/SDK:   additionalContext (camelCase, top-level)

set -euo pipefail

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

# Locate a project-local router, ignoring the plugin's own template.
project_router=""
for candidate in \
    "${PWD}"/skills/using-*/SKILL.md \
    "${PWD}"/.claude/skills/using-*/SKILL.md
do
    [ -f "${candidate}" ] || continue
    case "${candidate}" in
        */using-template/SKILL.md) continue ;;
    esac
    project_router="${candidate}"
    break
done

if [ -n "${project_router}" ]; then
    router_content=$(cat "${project_router}" 2>/dev/null || true)
    if [ -n "${router_content}" ]; then
        router_rel="${project_router#"${PWD}"/}"
        body="This project has its own workflow router at \`${router_rel}\`. Follow its routing table to pick the smallest combination of skill / agent playbook / reusable prompt / scoped instruction for the request.

---

${router_content}"
    fi
fi

if [ -z "${body:-}" ]; then
    body="Pick the smallest set of skills that satisfies the request before starting any non-trivial task. A single skill is enough for most asks.

Available skills: /plan, /tdd, /verify, /review, /security-review, /diagnose, /design, /clarify-requirements, /harden-plan, /new-feature, /handoff, /zoom-out, /devops, /write-skill.

For a larger feature, chain: /clarify-requirements -> /design (if architectural) -> /harden-plan (if domain terms are at stake) -> /plan -> /tdd per task -> /verify -> /review. /new-feature orchestrates this end-to-end from one entry point.

Do not stack overlapping skills to be safe. Route once, then execute. AGENTS.md and any scoped instruction files stay authoritative for the rules; skills only guide execution.

This project has no router of its own. To add one, copy \`skills/using-template/\` from this plugin to \`skills/using-<project>/\` and fill in its routing table."
fi

session_context="<IMPORTANT>
The workflow-skills plugin is loaded.

${body}
</IMPORTANT>"

session_context=$(escape_for_json "${session_context}")

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
