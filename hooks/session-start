#!/usr/bin/env bash
# SessionStart hook for the workflow-skills plugin.
#
# Injects routing guidance into the agent's context at the start of every
# session, so it picks the smallest combination of skill/agent/prompt/
# instruction for the user's request before doing work.
#
# What gets injected depends on the project:
#   - Project has its own router (.claude/skills/using-<project>/SKILL.md, or
#     legacy skills/using-<project>/SKILL.md) -> inject that router in full.
#     It has concrete routes for this codebase; that is the useful one.
#   - No project router -> inject a slim fallback naming the available skills
#     and the standard chain. The plugin's own using-template is never
#     injected: its routing table is an empty placeholder, so shipping it into
#     every session costs context and routes nothing.
#
# Detects the harness via env vars and emits the right JSON dialect:
#   - Cursor:      additional_context (snake_case, top-level)
#   - Claude Code: hookSpecificOutput.additionalContext (nested)
#   - Codex/SDK:   additionalContext (camelCase, top-level)

set -euo pipefail

escape_for_json() {
    # Byte-wise (LC_ALL=C) so UTF-8 passes through untouched. Every control
    # character is escaped: \n \r \t by name, the rest of 0x01-0x1F as \u00XX,
    # since any of them unescaped makes the whole JSON payload invalid. awk
    # instead of ${s//...}: bash 3.2 substitution is quadratic and took seconds
    # on a 10 KB router.
    printf '%s' "$1" | LC_ALL=C awk '
        BEGIN {
            for (i = 1; i < 32; i++) esc[sprintf("%c", i)] = sprintf("\\u%04x", i)
            esc["\t"] = "\\t"; esc["\r"] = "\\r"
            esc["\\"] = "\\\\"; esc["\""] = "\\\""
        }
        {
            if (NR > 1) printf "\\n"
            n = length($0)
            for (j = 1; j <= n; j++) {
                c = substr($0, j, 1)
                printf "%s", ((c in esc) ? esc[c] : c)
            }
        }'
}

# Where the session started: the harness's own variable if it sets one, else
# the current directory. Cursor runs plugin hooks from the plugin's install
# directory, so CURSOR_PROJECT_DIR matters there; Claude Code sets
# CLAUDE_PROJECT_DIR to the start directory, which may be a subdirectory.
start_dir="${CLAUDE_PROJECT_DIR:-${CURSOR_PROJECT_DIR:-$PWD}}"
start_dir=$(cd "${start_dir}" 2>/dev/null && pwd -P || printf '%s' "${PWD}")

# Walk up from the start directory to the git root, the way Claude Code
# discovers project skills, and take the closest router. Outside a git repo
# only the start directory counts: walking up to / could pick up a router that
# belongs to something else.
stop_dir=$(git -C "${start_dir}" rev-parse --show-toplevel 2>/dev/null || true)
stop_dir="${stop_dir:-$start_dir}"

# Locate a project-local router, ignoring the plugin's own template.
project_router=""
project_dir="${start_dir}"
while :; do
    for candidate in \
        "${project_dir}"/.claude/skills/using-*/SKILL.md \
        "${project_dir}"/skills/using-*/SKILL.md
    do
        [ -f "${candidate}" ] || continue
        case "${candidate}" in
            */using-template/SKILL.md) continue ;;
        esac
        project_router="${candidate}"
        break 2
    done
    [ "${project_dir}" = "${stop_dir}" ] && break
    [ "${project_dir}" = "/" ] && break
    project_dir=$(dirname "${project_dir}")
done

if [ -n "${project_router}" ]; then
    router_content=$(cat "${project_router}" 2>/dev/null || true)
    if [ -n "${router_content}" ]; then
        router_rel="${project_router#"${project_dir}"/}"
        body="This project has its own workflow router at \`${router_rel}\`. Follow its routing table to pick the smallest combination of skill / agent playbook / reusable prompt / scoped instruction for the request.

---

${router_content}"
    fi
fi

if [ -z "${body:-}" ]; then
    body="Pick the smallest set of skills that satisfies the request before starting any non-trivial task. A single skill is enough for most asks.

Available skills: /plan, /tdd, /verify, /review, /security-review, /diagnose, /design, /clarify-requirements, /harden-plan, /new-feature, /handoff, /zoom-out, /devops, /write-skill.

For a larger feature, chain: /clarify-requirements -> /design (if architectural) -> /harden-plan (if domain terms are at stake) -> /plan -> /tdd per task -> /verify -> /review. /new-feature orchestrates this end-to-end from one entry point.

Do not stack overlapping skills to be safe. Route once, then execute. AGENTS.md and any scoped instruction files stay authoritative for the rules; skills only guide execution.

This project has no router of its own. To add one, copy \`skills/using-template/\` from this plugin to \`.claude/skills/using-<project>/\` and fill in its routing table."
fi

session_context="<IMPORTANT>
The workflow-skills plugin is loaded.

${body}
</IMPORTANT>"

session_context=$(escape_for_json "${session_context}")

if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
